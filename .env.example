# Server-side secrets: set in Vercel > Project > Settings > Environment Variables
RESEND_API_KEY=re_your_key
CONTACT_FROM_EMAIL=AERO <hello@your-verified-domain.com>
TURNSTILE_SITE_KEY=your_public_cloudflare_turnstile_site_key
TURNSTILE_SECRET_KEY=your_secret_cloudflare_turnstile_key
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_rest_token
# Optional: restrict Turnstile verified host to your live domain, no https://
# ALLOWED_HOSTNAME=yourdomain.com
